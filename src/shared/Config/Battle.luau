-- Автоматический бой с боссом (D22, D40): игрок и босс обмениваются ударами сами, пока HP одного не станет 0
-- (или бой не прервёт ночь). Таймера и заранее решённого исхода нет: каждый удар считается на сервере в момент удара.
-- Сила (Strength) игрока растит урон и HP (и скорость бега — Shared/Speed), но не частоту атак.
-- ЧИСЛА ТЕСТОВЫЕ, НЕ УТВЕРЖДЕНЫ (босс 1 — D40): проверяются серверными тестами на разных силах.
-- Читается сервером и клиентом. Ни от чего не зависит.

return {
	Player = {
		BaseHP = 100,
		BaseDamage = 10,
		AttackInterval = 0.9, -- секунд между ударами игрока (от силы не зависит)
		Growth = 0.5, -- HP и урон × (1 + Strength) ^ Growth
		Reach = 3, -- на сколько дальше дистанции атаки босса игрок ещё достаёт его
	},

	-- Боссы по номеру зоны. Strength — сила босса той же шкалы, что у игрока (Progression.Bosses): HP и урон
	-- босса × (1 + Strength) ^ Growth. AttackRange — от центра босса до игрока, Leash — от места босса: дальше игрок
	-- считается сбежавшим, бой прекращается. Speed — бег за игроком и возвращение домой, стадов в секунду.
	Bosses = {
		[1] = {
			HP = 140,
			Damage = 8,
			AttackInterval = 1.4,
			Strength = 0,
			AttackRange = 9.5,
			Leash = 40,
			Speed = 10,
		},
	},

	DamageSpread = 0.15, -- ± доля случайного разброса каждого удара
	HitDelay = 0.25, -- от начала выпада босса до попадания (анимация «укус» или «лапа»), секунд

	-- Отброс проигравшего (без телепорта): скорость от босса и вверх, сколько держится толчок.
	Knockback = { Speed = 35, Up = 30, Time = 0.2 }, -- ≈ 15 стадов назад (проверено в Play)

	-- Длительности состояний босса (анимации клиента — те же числа), секунд.
	Timeline = {
		Wake = 1.0, -- проснулся лёжа: глаза открыты, голова поднята
		StandUp = 0.9,
		ToCombat = 0.5,
		Victory = 2.2, -- игрок проиграл: босс лает и виляет хвостом
		Defeat = 2.4, -- босс проиграл: повалился, встаёт
		FallAsleep = 1.6, -- дома: лёг, закрыл глаза
	},

	ArriveDistance = 1.2, -- босс «дома», если ближе к своему месту, стадов
	TickSeconds = 0.1, -- шаг серверного цикла боя
}
