-- Поимка «Ловибум», магазин Ловибумов, живые существа и обучение (D55): числа. Утверждено владельцем — виды и бонусы,
-- шансы после попадания, 3 броска, личная пауза 10 с, цены боссов 1–3 (2026-11-09), цены боссов 4–10 (D56,
-- 2026-11-11); остальное (мини-игра, блуждание, обучение) — предварительно. Цены 4–10 лежат в PreliminaryPrices: боссов
-- 4–10 ещё нет, поэтому в опубликованной игре их Ловибумы не продаются («Скоро»), только в Studio + DevMode — для
-- проверки магазина. Читается сервером и клиентом через GameConfig.Catch и Lune-проверками.
-- Ни от чего не зависит.

return {
	-- Виды Ловибумов по старшинству и бонус к шансу (D55): Бум ×1, Турбо ×1.5, Мега ×2.
	Kinds = { "Boom", "Turbo", "Mega" },
	Names = { Boom = "Бум", Turbo = "Турбо", Mega = "Мега" },
	Bonus = { Boom = 1, Turbo = 1.5, Mega = 2 },
	-- Шанс захвата после попадания = база редкости × бонус вида, не больше 100 % (D55, утверждено).
	BaseChance = { Common = 0.6, Rare = 0.35, Epic = 0.3, Legendary = 0.14, Secret = 0.06 },
	Levels = 10, -- Ловибум уровня N действует только на существ босса N

	-- Цены: уровень → вид → монеты за штуку. УТВЕРЖДЕНЫ владельцем 2026-11-09 (D55) для боссов 1–3: Бум ≈ 1 мин дохода
	-- игрока, который только дошёл до этого босса (на боссе 1 — новичка после обучения), Турбо = 2 Бума, Мега = 3 Бума
	-- (бонусы к шансу ×1 / ×1.5 / ×2 не меняются). Уровня нет в таблице — магазин его не продаёт («Скоро»).
	Prices = {
		[1] = { Boom = 1000, Turbo = 2000, Mega = 3000 },
		[2] = { Boom = 10000, Turbo = 20000, Mega = 30000 },
		[3] = { Boom = 30000, Turbo = 60000, Mega = 90000 },
	} :: { [number]: { [string]: number } },
	-- Боссы 4–10 — цены УТВЕРЖДЕНЫ владельцем 2026-11-11 (D56, согласованная модель экономики: Бум ≈ 1 мин дохода),
	-- но самих боссов ещё нет: в опубликованной игре не продаются; только Studio + DevMode (проверка магазина) с
	-- пометкой. Появится босс — перенести его уровень в Prices (имя таблицы — прежнее: её читают CatchRules и магазин).
	PreliminaryPrices = (function()
		local boom = { [4] = 300000, [5] = 4e6, [6] = 20e6, [7] = 80e6, [8] = 400e6, [9] = 2e9, [10] = 8e9 }
		local out = {}
		for level, price in boom do
			out[level] = { Boom = price, Turbo = price * 2, Mega = price * 3 }
		end
		return out
	end)() :: { [number]: { [string]: number } },
	MaxBuy = 99, -- штук за одну покупку
	BuyGap = 0.3, -- секунд: покупка чаще не принимается (двойное нажатие «Купить» — одна покупка)
	MaxStock = 9999, -- запас одного вида одного уровня

	-- Мини-игра (D55, числа предварительные).
	Game = {
		MaxThrows = 3,
		FailPause = 10, -- личная пауза у этого босса после любого конца без поимки (утверждено)
		PromptDistance = 10, -- радиус подсказки «Поймать»
		PromptHold = 0.3,
		FlightTime = 0.6, -- полёт Ловибума от руки до существа (попадание — по положению в момент прилёта)
		-- после попадания: существо втягивается в кристалл, Ловибум падает и трижды качается — поимка или побег (до боя)
		CaptureTime = 2.9,
		MissRest = 0.6, -- после промаха — до следующего броска (после прилёта)
		EscapeRest = 0.5, -- после побега из сети — до следующего броска (после сети)
		ClockSlack = 0.75, -- время отпускания от клиента — не раньше этого до времени сервера
		ClockAhead = 0.1, -- и не позже времени сервера больше чем на столько (часы клиента немного спешат)
		Idle = 30, -- без бросков столько секунд — мини-игра кончается (бездействие)
		Watchdog = 120, -- сессия поимки не дольше (сервер освобождает босса в любом случае)
		-- Кольцо прицеливания: радиус = (Max − (Max − Min) × фаза) × масштаб существа; фаза 0…1 за Period, потом заново.
		-- Попадание — точка прилёта внутри кольца в момент прилёта (на шанс поимки размер кольца не влияет).
		Circle = { Period = 2.4, Max = 1.25, Min = 0.45 },
		-- Камера поимки (Shared/CatchThrow.Frame; считает сервер): от места существа к ловящему на расстоянии
		-- (наибольший размер × Fit, от Min до Max), выше на расстояние × Rise, смотрит в центр существа; FOV —
		-- вертикальный угол обзора (бросок считается в долях высоты экрана); Tween — подлёт камеры; стена между
		-- существом и камерой — камера на Pad перед ней, но не ближе Near (сервер, луч).
		Camera = { FOV = 70, Fit = 1.9, Min = 4.5, Max = 11, Rise = 0.2, Tween = 0.8, Near = 2, Pad = 0.6 },
		EffectRadius = 120, -- кто видит броски, захват и побег
		FleeTime = 3, -- существо убегает и возвращается
		FleeDistance = 6,
		Blend = 0.6, -- после побега — плавно к месту блуждания
	},

	-- Бросок (Shared/CatchThrow): жест смахивания от Ловибума внизу экрана; всё — в долях высоты экрана.
	Throw = {
		BallY = 0.31, -- Ловибум лежит ниже центра экрана на эту долю высоты (клиент рисует, сервер считает отсюда)
		MinSwipe = 0.08, -- жест короче — не бросок (Ловибум не тратится)
		MaxSwipe = 3, -- длиннее — испорченный жест
		MinSpeed = 0.6, -- высот экрана в секунду в конце жеста: медленнее — не бросок (Ловибум остаётся)
		MaxSpeed = 12, -- быстрее — как MaxSpeed
		Ideal = 2.6, -- скорость, с которой Ловибум прилетает точно на высоту существа
		Spread = 0.25, -- недолёт / перелёт: сдвиг по высоте экрана = Spread × ln(Ideal / скорость)
		MaxAngle = 60, -- градусов от вертикали: жест сильнее вбок (или вниз) — не бросок
		Window = 0.1, -- скорость — по последним столько секунд движения (клиент)
		Grace = 0.08, -- указатель замер перед отпусканием не дольше этого — скорость берётся до остановки (клиент)
	},

	-- Живые существа (D55): блуждание у своего места. Радиус — по зоне: верх постамента 3.8 × 3.8 (небольшие шаги и
	-- прыжки на месте), подушки Подземки 3.7, площадка Барахолки — простор.
	Creature = {
		Wander = { Default = 0.45, [2] = 2.4, [3] = 0.7 },
		Segment = 3.4, -- секунд на «шаг» блуждания (переход + осмотр)
		Move = 0.9, -- из них на переход
		HopChance = 0.35, -- переход прыжком
		HopHeight = 0.7, -- высота прыжка × масштаб
		Look = 0.6, -- оглядывание, радианы
		-- Мини-игра: покачивание вбок и уклонения с заметным замахом (уклонение — часть движения, сервер считает так же).
		Sway = 0.35, -- × масштаб, стадов
		DodgeEvery = 3.2, -- секунд на цикл уклонения
		DodgeChance = 0.55,
		DodgeWindup = 0.95, -- замах (присед и наклон в сторону уклонения) — дольше полёта: увидел — успеешь не бросать
		DodgeDash = 0.22,
		DodgeHold = 0.55,
		DodgeBack = 0.45,
		DodgeSide = 1.6, -- × масштаб: вбок (на площадке) — или прыжок вверх (на постаменте и подушке)
		DodgeLeap = 1.8,
		ViewRadius = 140, -- клиент оживляет существ ближе этого к камере
	},

	-- Обучение (D55, числа предварительные): личные учебные существо и пёс у уровня 1.
	Tutorial = {
		ItemRarity = "Common",
		ItemBoss = 1,
		CircleFactor = 1.8, -- круг учебной поимки крупнее (первое попадание — захват)
		Near = 22, -- стадов: ученик подошёл к учебному существу ближе — шаг Intro → Catch
		FightHits = 5, -- ударов ученика до победы над учебным псом (бой по сценарию, всегда победа)
		FightStep = 0.9, -- секунд между ударами учебного боя
	},
}
