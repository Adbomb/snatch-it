-- «Бросок вдаль» (D75, основной цикл; решения владельца 2026-11-28): числа дальности, шкалы точности, удачи,
-- розыгрыша, продажи капсул и площадки. Правила — Shared/ThrowRules, проверка — scripts/lune/check_throw_rules.luau.
-- Пороги зон — силы боссов (Progression.Bosses, D56), шансы редкости существ — Progression.BossLoot.Tiers (D37),
-- редкость этажа — Config/FloorRarity (D74), цены Ловибумов — Config/Catch (D56, D61): здесь их нет.
-- УТВЕРЖДЕНО владельцем: точность до +18 %, Турбо +6 % и Мега +12 % к дальности, шанс босса 1 из 2 500 («после теста
-- подкрутим»), доход босса — Легендарное существо на Золотом этаже своей зоны, площадка на 5 мест, калибровка темпа
-- доходом наград по зонам. ПРЕДЛОЖЕНО (числа ждут взгляда владельца): формула метров, конец трассы, удача по глубине и
-- бонус удачи Турбо и Меги, цена продажи, параметры шкалы, множители дохода IncomeK.
-- Ни от чего не зависит.

return {
	-- Дальность, м = K × (1 + сила) ^ Power × точность × вид Ловибума. Отметка зоны N на трассе — та же формула при
	-- силе босса N без бонусов: сила босса N гарантирует зону N при любом нажатии шкалы.
	Metre = { K = 10, Power = 0.25 },
	-- Конец трассы, м: последняя отметка зоны 10 — самый дальний бросок в игре (рекорд дальности игрока — в профиле).
	EndMark = 15000,

	-- Шкала точности («нажми вовремя»). Фазу ведёт СЕРВЕР по своему времени: маркер ходит по шкале туда-обратно за
	-- Period секунд (у каждого броска период свой: ± PeriodJitter, и своё начало — заучить ритм нельзя), клиент шлёт
	-- только момент нажатия. Момент принимается не раньше «сейчас − LagCap» и не позже «сейчас» (учёт задержки сети с
	-- потолком); подделанный момент даёт не больше идеального попадания. Не нажал за Timeout — бросок с точностью 0.
	Scale = {
		Period = 1.6,
		PeriodJitter = 0.2,
		LagCap = 0.3,
		Timeout = 8,
		Perfect = 0.05, -- полуширина зоны «идеально» вокруг середины шкалы, доля шкалы
	},
	-- Точность: качество 0 (край шкалы) … 1 («идеально») → множитель дальности 1 … 1 + Max.
	Accuracy = { Max = 0.18 },

	-- Вид Ловибума: дальность и удача (Турбо стоит как 2 Бума, Мега — как 3; поимка в D75 не срывается).
	KindRange = { Boom = 1, Turbo = 1.06, Mega = 1.12 },
	KindLuck = { Boom = 1, Turbo = 1.15, Mega = 1.3 },

	-- Удача по глубине: глубина — доля пути между отметками зоны приземления (0 — у начала зоны, 1 — у конца).
	-- удача = (1 + Depth × глубина) × KindLuck[вид]; вес каждой следующей ступени редкости существа и этажа
	-- умножается на удача ^ Power. Показывается на экране броска («УДАЧА ×1.73»).
	Luck = { Depth = 1, Power = 0.5 },

	-- Босс зоны приземления: шанс с броска (на удачу не умножается). Доход — как у существа редкости Rarity на этаже
	-- редкости Floor своей зоны; в зонах без Легендарных существ — LegendaryOfEpic × средний Эпический (D56).
	BossChance = 1 / 2500,
	Boss = { Rarity = "Legendary", Floor = "Gold" },

	-- Продажа ненужной капсулы: доход этажа за столько секунд, не меньше одной монеты.
	SellSeconds = 60,

	-- Калибровка темпа (D56: зоны 7 / 8 / 9 / 10 — на 14 / 28 / 56 / 84 ч): доход наград зоны N × IncomeK[N].
	-- Итог scripts/sim/economy84/d75_recalc.py (report_d75.md): обычный игрок долетает до зон 7 / 8 / 9 / 10 за
	-- 10.3 / 24.0 / 57.5 / 74.7 ч; ниже 0.3 множитель не опускается — следующая зона должна оставаться выгоднее прошлой.
	IncomeK = { 1, 1, 0.45, 0.3, 0.3, 0.3, 0.3, 0.37, 0.3, 0.3 },

	-- Площадка броска: одна общая, мест для одновременных бросков.
	Pad = { Places = 5 },
}
